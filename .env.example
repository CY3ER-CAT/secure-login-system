# Copy this file to .env and replace every placeholder before running.
# Generate secrets on macOS with:
#   openssl rand -hex 64   # SESSION_SECRET
#   openssl rand -hex 32   # TWO_FACTOR_ENCRYPTION_KEY
#   openssl rand -hex 32   # RECOVERY_CODE_PEPPER

NODE_ENV=development
PORT=3000

SESSION_SECRET=replace-with-64-bytes-of-hex
TWO_FACTOR_ENCRYPTION_KEY=replace-with-32-bytes-of-hex
RECOVERY_CODE_PEPPER=replace-with-32-bytes-of-hex

DATABASE_PATH=database/secure-login.sqlite
SESSION_TTL_MINUTES=30
SESSION_COOKIE_NAME=sls.sid
BCRYPT_ROUNDS=12

LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_MAX=5
TWO_FACTOR_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=300
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_MINUTES=15

# Only enable when a trusted reverse proxy sets X-Forwarded-* headers.
TRUST_PROXY=false

TWO_FACTOR_ISSUER=Secure Login System
