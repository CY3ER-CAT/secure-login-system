{
  "name": "secure-login-system",
  "version": "1.0.0",
  "description": "A production-shaped secure authentication system with Node.js, Express, SQLite and TOTP two-factor authentication.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch app.js --watch server.js --watch routes --watch middleware --watch config --watch utils server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "keywords": [
    "authentication",
    "security",
    "express",
    "sqlite",
    "bcrypt",
    "totp"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "csrf-sync": "^4.2.1",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  }
}
